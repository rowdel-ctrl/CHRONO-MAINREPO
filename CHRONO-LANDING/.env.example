# Optional overrides. Copy to .env to use.
# Teacher and admin sign in at <VITE_DASHBOARD_URL>/login
VITE_DASHBOARD_URL=https://chronoquest-dashboard.vercel.app

# Leave unset to serve the APK from public/downloads/chronoquest.apk
# VITE_APK_URL=https://github.com/<owner>/<repo>/releases/latest/download/chronoquest.apk
VITE_APK_VERSION=1.1.0
# VITE_APK_SIZE=36 MB
VITE_CONTACT_EMAIL=contact@your-email.com
